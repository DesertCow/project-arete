# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://user:pass@host:5432/arete

# Auth
# Restrict registration to one email domain. Use '*' to open registration.
ALLOWED_EMAIL_DOMAIN=coros.com
JWT_SECRET=<generate-256-bit-key>
JWT_ALGORITHM=HS256
BCRYPT_SALT_ROUNDS=12

# AI
AI_PROVIDER=claude
ANTHROPIC_API_KEY=<key>
# Model used for all coach responses (streaming and non-streaming).
# Options: claude-opus-5 | claude-sonnet-5 | claude-sonnet-4-6 | claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-4-6

# COROS OAuth
# No client ID or secret needed — Arete auto-registers with COROS via dynamic
# client registration (public client + PKCE) and caches the client_id in memory.
COROS_MCP_SERVER_URL=https://mcp.coros.com/mcp
COROS_CALLBACK_URL=http://localhost:3001/api/coros/callback
COROS_TOKEN_ENCRYPTION_KEY=<64-char-hex-string-use-openssl-rand-hex-32>

# Weather MCP
WEATHER_MCP_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DEMO_RATE_LIMIT_MAX=10
DEMO_RATE_LIMIT_COOLDOWN_MS=30000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://user:pass@host:5432/arete

# Auth
JWT_SECRET=<generate-256-bit-key>
JWT_ALGORITHM=HS256
BCRYPT_SALT_ROUNDS=12

# AI
AI_PROVIDER=claude
ANTHROPIC_API_KEY=<key>
# Model used for all coach responses (streaming and non-streaming).
# Options: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5 | claude-sonnet-4-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# COROS MCP
COROS_MCP_SERVER_URL=<verify-with-team>
COROS_MCP_CLIENT_ID=<from-oauth-setup>
COROS_MCP_CLIENT_SECRET=<from-oauth-setup>
COROS_TOKEN_ENCRYPTION_KEY=<generate-256-bit-key>

# Weather MCP
WEATHER_MCP_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DEMO_RATE_LIMIT_MAX=10
DEMO_RATE_LIMIT_COOLDOWN_MS=30000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
